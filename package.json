{
  "name": "zentro-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "verify:api-catalog": "node scripts/verify-api-catalog.mjs",
    "verify:links": "node scripts/verify-internal-links.mjs",
    "test:security": "node scripts/security-regression.mjs",
    "test:decision-core": "node scripts/test-decision-core.mjs",
    "test:policy-enforcement": "node scripts/test-policy-enforcement.mjs",
    "test:policy-review-flow": "node scripts/test-policy-review-flow.mjs",
    "test:decision-intelligence": "node scripts/test-decision-intelligence.mjs",
    "test:approval-policy": "node scripts/test-approval-policy.mjs",
    "test:slo-triage-ui": "node scripts/test-slo-triage-ui.mjs",
    "verify:release": "npm run verify:api-catalog && npm run verify:links && npm run test:security && npm run test:decision-core && npm run test:decision-intelligence && npm run test:approval-policy && npm run test:policy-enforcement && npm run test:policy-review-flow && npm run test:slo-triage-ui",
    "gen:alert-signature": "node scripts/gen-alert-signature.mjs",
    "gen:favicon": "node scripts/gen-favicon.mjs",
    "prebuild": "node scripts/gen-favicon.mjs",
    "build": "npm run verify:release && next build",
    "start": "next start --hostname 0.0.0.0",
    "deploy:railway": "npm run verify:release && railway up --detach",
    "lint": "eslint"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.103.3",
    "lucide-react": "^0.544.0",
    "next": "16.2.4",
    "react": "19.2.6",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
