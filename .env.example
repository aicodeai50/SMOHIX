# --- Site (defaults to https://shynvo.app if unset) ---
# NEXT_PUBLIC_SITE_URL=https://shynvo.app

# --- Lemon Squeezy (billing) ---
# Checkout URL from your product / variant in the Lemon dashboard (public).
# When unset, "Start trial" CTAs scroll to #trial on the homepage.
NEXT_PUBLIC_LEMONSQUEEZY_CHECKOUT_URL=

# Signing secret from Webhook settings (server only — never NEXT_PUBLIC).
LEMONSQUEEZY_WEBHOOK_SIGNING_SECRET=

# --- Optional: backend URLs for server-side proxying later ---
# SHYNVO_REASONING_API_URL=
# SHYNVO_ROBOT_API_URL=
