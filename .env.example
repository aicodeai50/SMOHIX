# Copy to ".env.local" for local dev (never commit .env.local).
# In production, set variables in Railway → Service → Variables (not in git).
#
# FRONTEND vs SERVER
# -----------------
# • "Frontend env" in Next.js = any name starting with NEXT_PUBLIC_
#   Those values are inlined into the JavaScript sent to the browser — treat them as WORLD-READABLE.
#   Never put OpenAI keys, webhook secrets, or service_role keys in NEXT_PUBLIC_*.
# • Variables WITHOUT that prefix are server-only (API routes, Server Components, middleware).
#   OPENAI_API_KEY and ZENTRO_* URLs live here; the browser never sees them.
# • Copilot: the browser only calls same-origin paths like /api/copilot/chat; the server reads OPENAI_API_KEY.

# --- NEXT_PUBLIC_* (browser / frontend — non-secrets only) ---
# NEXT_PUBLIC_SITE_URL=https://zentro.run
# Always use your custom domain in production — not *.up.railway.app — so Google ties favicon/snippets to zentro.run.
# (If NEXT_PUBLIC_SITE_URL points at Railway, metadata is normalized to https://zentro.run anyway.)
# Railway-only preview: ZENTRO_SKIP_CANONICAL_HOST_REDIRECT=1 disables *.up.railway.app → zentro.run redirects.
# --- PayPal billing (replaces Lemon Squeezy) ---
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_MODE=sandbox
# PAYPAL_WEBHOOK_ID=
# PAYPAL_PLAN_ID_PRO=
# PAYPAL_PLAN_ID_TEAM=
# Optional: centralized billing via ZENTRO-OWN-API
# REACT_APP_ZENTRO_OWN_API=http://zentro-own-api.railway.internal
# ZENTRO_OWN_API_SECRET=

# --- Legacy Lemon Squeezy (deprecated — remove after PayPal migration) ---
# NEXT_PUBLIC_LEMONSQUEEZY_CHECKOUT_URL=https://your-store.lemonsqueezy.com/checkout/buy/...
# Optional: second product (e.g. Team) — Billing + marketing show Team checkout when set
# NEXT_PUBLIC_LEMONSQUEEZY_TEAM_CHECKOUT_URL=https://your-store.lemonsqueezy.com/checkout/buy/...
# Optional: Lemon variant ids — Billing shows "Zentro Pro" / "Zentro Team" instead of generic "Paid"
# NEXT_PUBLIC_LEMONSQUEEZY_PRO_VARIANT_ID=
# NEXT_PUBLIC_LEMONSQUEEZY_TEAM_VARIANT_ID=
# Optional: Lemon customer portal (manage card, cancel) — show on Billing when plan is paid
# NEXT_PUBLIC_LEMONSQUEEZY_CUSTOMER_PORTAL_URL=https://...
# LEMONSQUEEZY_CUSTOMER_PORTAL_URL=https://...   # server-only alternative
# Optional: where Copilot POSTs from the browser (default /api/copilot/chat).
# Built-in route tries OpenAI → REACT_APP_SH_BACKEND_API/v1/chat → guided offline.
# Set this only to bypass the built-in route and call the authenticated reasoning proxy directly:
# NEXT_PUBLIC_COPILOT_PROXY_PATH=/api/reasoning/v1/chat

# Optional: embed a hosted product demo on /docs/demo (AI-generated or any MP4 you uploaded).
# YouTube watch URL, youtu.be, Shorts, Loom share, Vimeo, or HTTPS direct .mp4/.webm/.ogg — non-secret.
# Prefer DEMO_VIDEO_URL (server-only, readable at runtime — change on Railway without rebuild).
# DEMO_VIDEO_URL=https://www.youtube.com/watch?v=YOUR_VIDEO_ID
# Legacy: NEXT_PUBLIC_DEMO_VIDEO_URL (inlined at build time)
# NEXT_PUBLIC_DEMO_VIDEO_URL=

# --- Server-only secrets (never NEXT_PUBLIC_) ---
# OpenAI: used only inside /api/copilot/chat — NOT available on the frontend
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini

# Production observability (optional but recommended)
# SENTRY_DSN=
# ZENTRO_LOG_LEVEL=info

# Shared rate limiting for multi-replica Railway deployments (optional; falls back to memory locally)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Webhook signing secret from Lemon Squeezy (rotate if it was ever committed).
LEMONSQUEEZY_WEBHOOK_SIGNING_SECRET=

# Server-side canonical URL used in scheduled jobs and email links.
# ZENTRO_SITE_URL=https://zentro.run

# --- Linked backends (server only — Railway private network) ---
# Primary env names (set on Railway for SHYNVO/Zentro):
# REACT_APP_SH_BACKEND_API=http://sh-backend-api.railway.internal
# REACT_APP_ROBOT_BACKEND=http://robot_backend.railway.internal
# REACT_APP_ZENTRO_HUB=http://zentro-hub.railway.internal
# REACT_APP_ZENTRO_OWN_API=http://zentro-own-api.railway.internal
#
# Legacy fallbacks (local dev): ZENTRO_REASONING_API_URL, ZENTRO_ROBOT_API_URL, ZENTRO_HUB_URL, ZENTRO_OWN_API_URL
# Proxies: GET /api/reasoning/health → {SH backend}/health , GET /api/robot/docs → {robot}/docs
REACT_APP_SH_BACKEND_API=
REACT_APP_ROBOT_BACKEND=
# REACT_APP_ZENTRO_HUB=
# REACT_APP_ZENTRO_OWN_API=
# ZENTRO_REASONING_API_URL=
# ZENTRO_ROBOT_API_URL=
# Optional: Slack incoming webhook for approval/execution notifications
ZENTRO_SLACK_WEBHOOK_URL=
# Optional: Slack signed inbound actions for approvals endpoint (/api/integrations/slack/approvals)
ZENTRO_SLACK_SIGNING_SECRET=
# Optional: Slack event controls (default true). Set false to reduce noise.
ZENTRO_SLACK_NOTIFY_APPROVALS=true
ZENTRO_SLACK_NOTIFY_EXECUTIONS=true
ZENTRO_SLACK_NOTIFY_COMPLIANCE_SLA=true
# Optional: weekly compliance SLA reminder cron (POST /api/governance/compliance/sla-reminders/scheduled)
ZENTRO_SLA_CRON_SECRET=
# Optional: other scheduled compliance jobs use their own Bearer secrets. Configure the ones you enable:
# ZENTRO_BUNDLE_CRON_SECRET=
# ZENTRO_DIGEST_CRON_SECRET=
# ZENTRO_ATTESTATION_RENEWAL_CRON_SECRET=
# ZENTRO_EVIDENCE_REQUEST_SLA_CRON_SECRET=
# ZENTRO_MAPPING_DIGEST_CRON_SECRET=
# ZENTRO_OBLIGATION_DENSITY_CRON_SECRET=
# ZENTRO_COMMITTEE_DIGEST_CRON_SECRET=
# ZENTRO_STAFFING_REMINDER_CRON_SECRET=
# ZENTRO_STAFFING_ROLLUP_CRON_SECRET=
# ZENTRO_STAFFING_SLA_CRON_SECRET=
# ZENTRO_CROSS_STAFFING_CRON_SECRET=
# ZENTRO_STAFFING_AUTO_CHAIN_CRON_SECRET=
# Optional: Resend transactional email for compliance SLA reminders
ZENTRO_RESEND_API_KEY=
ZENTRO_EMAIL_FROM=Zentro <notifications@zentro.run>

# Optional: extra HMAC check for alert ingest. Bearer ingest tokens are always required.
# ZENTRO_ALERT_WEBHOOK_SIGNING_SECRET=

# --- Supabase (auth — set both for sign-in / protected console; omit both to skip auth locally) ---
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=  # server only — PayPal webhook → subscriptions; alert ingest; contact leads API

# --- Contact lead intake (zentro.run marketing) ---
# Comma-separated emails allowed to access /admin/leads (platform admin, not org RBAC)
# ZENTRO_PLATFORM_ADMIN_EMAILS=admin@example.com
# Optional: generic webhook for new lead notifications (JSON POST)
# ZENTRO_CONTACT_WEBHOOK_URL=
# Optional: salt for hashed rate-limit keys (defaults to dev-only value locally)
# ZENTRO_CONTACT_HASH_SALT=
# Dev only: in-memory lead store when service role is unavailable (NODE_ENV=development)
# ZENTRO_CONTACT_DEV_STORE=1

# --- Analytics (optional, privacy-conscious) ---
# NEXT_PUBLIC_ANALYTICS_PROVIDER=plausible
# NEXT_PUBLIC_ANALYTICS_REQUIRES_CONSENT=true

# --- Changelog GitHub sync (manual review — server only) ---
# GITHUB_TOKEN=
# GITHUB_CHANGELOG_REPO=aicodeai50/ZENTRO
