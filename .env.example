# Copy to ".env.local" for local dev (never commit .env.local).
# In production, set variables in Railway → Service → Variables (not in git).
#
# FRONTEND vs SERVER
# -----------------
# • "Frontend env" in Next.js = any name starting with NEXT_PUBLIC_
#   Those values are inlined into the JavaScript sent to the browser — treat them as WORLD-READABLE.
#   Never put OpenAI keys, webhook secrets, or service_role keys in NEXT_PUBLIC_*.
# • Variables WITHOUT that prefix are server-only (API routes, Server Components, middleware).
#   OPENAI_API_KEY and ZENTRO_* URLs live here; the browser never sees them.
# • Copilot: the browser only calls same-origin paths like /api/copilot/chat; the server reads OPENAI_API_KEY.

# --- NEXT_PUBLIC_* (browser / frontend — non-secrets only) ---
# NEXT_PUBLIC_SITE_URL=https://zentro.run
# NEXT_PUBLIC_LEMONSQUEEZY_CHECKOUT_URL=https://your-store.lemonsqueezy.com/checkout/buy/...
# Optional: second product (e.g. Team) — Billing + marketing show Team checkout when set
# NEXT_PUBLIC_LEMONSQUEEZY_TEAM_CHECKOUT_URL=https://your-store.lemonsqueezy.com/checkout/buy/...
# Optional: Lemon variant ids — Billing shows "Zentro Pro" / "Zentro Team" instead of generic "Paid"
# NEXT_PUBLIC_LEMONSQUEEZY_PRO_VARIANT_ID=
# NEXT_PUBLIC_LEMONSQUEEZY_TEAM_VARIANT_ID=
# Optional: Lemon customer portal (manage card, cancel) — show on Billing when plan is paid
# NEXT_PUBLIC_LEMONSQUEEZY_CUSTOMER_PORTAL_URL=https://...
# LEMONSQUEEZY_CUSTOMER_PORTAL_URL=https://...   # server-only alternative
# Optional: where Copilot POSTs (default /api/copilot/chat). Change only if you want the UI to hit /api/reasoning/... instead.
# NEXT_PUBLIC_COPILOT_PROXY_PATH=/api/reasoning/v1/chat

# Optional: embed a hosted product demo on /docs/demo (AI-generated or any MP4 you uploaded).
# YouTube watch URL, youtu.be, Shorts, Loom share, Vimeo, or HTTPS direct .mp4/.webm/.ogg — non-secret.
# Prefer DEMO_VIDEO_URL (server-only, readable at runtime — change on Railway without rebuild).
# DEMO_VIDEO_URL=https://www.youtube.com/watch?v=YOUR_VIDEO_ID
# Legacy: NEXT_PUBLIC_DEMO_VIDEO_URL (inlined at build time)
# NEXT_PUBLIC_DEMO_VIDEO_URL=

# --- Server-only secrets (never NEXT_PUBLIC_) ---
# OpenAI: used only inside /api/copilot/chat — NOT available on the frontend
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o-mini

# Webhook signing secret from Lemon Squeezy (rotate if it was ever committed).
LEMONSQUEEZY_WEBHOOK_SIGNING_SECRET=

# --- Linked services (server only — no NEXT_PUBLIC_) ---
# Proxies: GET /api/reasoning/health → {REASONING_URL}/health , GET /api/robot/docs → {ROBOT}/docs
# ZENTRO_REASONING_API_URL=https://your-reasoning-service.up.railway.app
# ZENTRO_ROBOT_API_URL=https://your-automation-service.up.railway.app
ZENTRO_REASONING_API_URL=
ZENTRO_ROBOT_API_URL=
# Optional: Slack incoming webhook for approval/execution notifications
ZENTRO_SLACK_WEBHOOK_URL=
# Optional: Slack signed inbound actions for approvals endpoint (/api/integrations/slack/approvals)
ZENTRO_SLACK_SIGNING_SECRET=
# Optional: Slack event controls (default true). Set false to reduce noise.
ZENTRO_SLACK_NOTIFY_APPROVALS=true
ZENTRO_SLACK_NOTIFY_EXECUTIONS=true

# --- Supabase (auth — set both for sign-in / protected console; omit both to skip auth locally) ---
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=  # server only — Lemon webhook → subscriptions; alert ingest (/api/integrations/alerts) verifies tokens + inserts incidents
