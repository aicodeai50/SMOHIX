# Copy to ".env.local" for local dev (never commit .env.local).
# In production, set variables in Railway → Service → Variables (not in git).

# --- Public (safe to expose to the browser — only use NEXT_PUBLIC_* for non-secrets) ---
# NEXT_PUBLIC_SITE_URL=https://shynvo.app
# NEXT_PUBLIC_LEMONSQUEEZY_CHECKOUT_URL=https://your-store.lemonsqueezy.com/checkout/...

# --- Secrets (server only — NEVER prefix with NEXT_PUBLIC_, never commit real values) ---
# Webhook signing secret from Lemon Squeezy (rotate if it was ever committed).
LEMONSQUEEZY_WEBHOOK_SIGNING_SECRET=

# --- Backend base URLs (server only — no NEXT_PUBLIC_) ---
# These are NOT sent to the browser; Next reads them only on the server (RSC, Route Handlers).
# Still: do not put API keys here in this file; set real URLs only in Railway or .env.local.
# SHYNVO_REASONING_API_URL=https://your-reasoning-service.up.railway.app
# SHYNVO_ROBOT_API_URL=https://your-robot-service.up.railway.app
SHYNVO_REASONING_API_URL=
SHYNVO_ROBOT_API_URL=
